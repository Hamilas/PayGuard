# PayGuard Environment Variables
# Copy to .env and adjust as needed: cp .env.example .env
# docker-compose.yml already wires sensible defaults for local use.

# ---------------------------------------------------------------------------
# MLflow
# ---------------------------------------------------------------------------
# Internal tracking URI used by fraud-api and the trainer (docker network)
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_NAME=fraud_detection_xgboost
MODEL_STAGE=Staging

# ---------------------------------------------------------------------------
# Fraud Detection API (ml/serving/fraud_api.py)
# ---------------------------------------------------------------------------
# Number of recent predictions kept in memory for the /stats endpoint
PREDICTION_HISTORY_SIZE=200

# ---------------------------------------------------------------------------
# PayStream traffic simulator (paystream/paystream.py)
# ---------------------------------------------------------------------------
FRAUD_API_URL=http://fraud-api:8000
# normal | drift | attack | degraded
MODE=normal

# ---------------------------------------------------------------------------
# Training (ml/training/train_local.py)
# ---------------------------------------------------------------------------
PARQUET_PATH=ml/data/paysim_features.parquet

# ---------------------------------------------------------------------------
# Optional — original AWS/K8s architecture (NOT required for local run)
# These were used by the full 19-node LangGraph agent + Argo Rollouts +
# Airflow stack documented in README.md. Left here for reference only.
# ---------------------------------------------------------------------------
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
